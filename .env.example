# Optional — NewsAPI (omit for RSS-only headlines)
# NEWSAPI_KEY=your_newsapi_key_here
# Optional — override NewsAPI endpoint (default: /v2/top-headlines?country=in). /everything needs `q` unless you put it in the URL.
# GET_NEWS_API_URL=https://newsapi.org/v2/everything
# Optional — fixed `q` for /everything (skips auto query from RSS). Keep short to avoid queryTooLong.
# NEWSAPI_EVERYTHING_Q=India
# Optional — retry `q` when NewsAPI returns queryTooLong (default: India)
# NEWSAPI_EVERYTHING_FALLBACK_Q=India

# Optional — extra RSS/Atom URLs for trend headlines (comma or newline separated). Tried first, then built-in India feeds.
# RSS_TREND_FEED_URLS=https://example.com/india.xml

# LLM connectivity (no full trending run): GET /api/llm-health  — optional ?all=1 | ?ollama=1 | ?gemini=1

# LLM: "gemini" (default) or "ollama"
# LLM_PROVIDER=gemini
# Optional — LLM HTTP timeout in ms (3000–300000). Default 8000. Raise for slow local Ollama (e.g. 120000).
# LLM_FETCH_TIMEOUT_MS=8000

# Optional — how many trending topics to return (1–10). Default 10 (one per category). Use 1 for a fast single-topic demo with real RSS/News → LLM.
# TRENDING_TOPIC_COUNT=10

# --- Google Gemini (cloud, when LLM_PROVIDER is gemini or unset) ---
GEMINI_API_KEY=your_google_ai_studio_key_here
# GEMINI_MODEL=gemini-2.0-flash

# --- Anthropic Claude (cloud, optional — tried before Gemini when ANTHROPIC_API_KEY is set; max_tokens=2000) ---
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Local Ollama (on-prem Llama, when LLM_PROVIDER=ollama) ---
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# Optional — Ollama HTTP timeout (ms), 10000–1800000 (30 min). Default 300000 (5 min).
# OLLAMA_FETCH_TIMEOUT_MS=600000
# Optional — context window (2048–32768). Default 8192 so system prompt + RSS + news fit (4096 often truncates and breaks JSON).
# OLLAMA_NUM_CTX=8192
# Optional — max new tokens in JSON reply. Default 4200 (10 topics). Raise if output truncates mid-array.
# OLLAMA_NUM_PREDICT=4200
# Optional — slim prompt size for Ollama (defaults: 8 RSS terms + 5 articles).
# OLLAMA_MAX_RSS_TERMS=8
# OLLAMA_MAX_ARTICLES=5
# Optional — GET /api/trending?stream=1 (Ollama only): one smaller LLM call per news article, streamed via SSE (needs NEWSAPI_KEY for articles). Restart Vite after setting VITE_TRENDING_SSE.
# VITE_TRENDING_SSE=1
# Optional — max new tokens per article when stream=1 (256–8192). Default 1600 (raise if JSON truncates).
# OLLAMA_PER_ARTICLE_NUM_PREDICT=1600
# Optional — Ollama `format: json` (often yields tiny ~150-token JSON). Default off; set to 1 to experiment.
# OLLAMA_FORMAT_JSON=0
# Optional — log full Ollama /api/chat request JSON + copy-pastable curl and full response JSON (large; dev only).
# OLLAMA_DEBUG_CURL=1
# Optional — max chars logged for request/response bodies when OLLAMA_DEBUG_CURL=1 (defaults ~500k each).
# OLLAMA_DEBUG_MAX_BODY_CHARS=500000
# OLLAMA_DEBUG_MAX_RESPONSE_CHARS=500000
